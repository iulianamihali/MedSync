    "html": "<!DOCTYPE html><html lang='en'><body style='margin:0; padding:0; background-color:#f9fafb; font-family:Arial, sans-serif;'><div style='max-width:520px; margin:32px auto; background-color:#ffffff; border-radius:8px; border:1px solid #e5e7eb; padding:24px; box-shadow:0 2px 6px rgba(0,0,0,0.05);'><h2 style='color:#b91c1c; font-size:20px; margin-bottom:12px;'>❌ Institution Rejected</h2><p style='color:#374151; font-size:14px; line-height:22px; margin-bottom:12px;'>We appreciate your interest in joining <strong>MedSync</strong>. However, after reviewing your institution <strong>{{InstitutionName}}</strong>, we were unable to approve your registration at this time.</p><p style='color:#374151; font-size:14px; line-height:22px; margin-bottom:16px;'>This may be due to incomplete information, missing verification details, or other eligibility requirements.</p><p style='color:#6b7280; font-size:13px; line-height:20px; margin-bottom:24px;'>If you believe this decision was made in error or would like more information, please contact us at <a href='mailto:contact@medsync.com' style='color:#2563eb; text-decoration:none;'>contact@medsync.com</a>.</p><hr style='border:none; border-top:1px solid #e5e7eb; margin:24px 0;' /><div style='text-align:center; color:#9ca3af; font-size:12px;'><strong>MedSync</strong><br/>Automated notification – please do not reply.</div></div></body></html>"
  },
  "DoctorApproved": {
