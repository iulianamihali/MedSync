    "html": "<!DOCTYPE html><html lang='en'><body style='margin:0; padding:0; background-color:#f9fafb; font-family:Arial, sans-serif;'><div style='max-width:520px; margin:32px auto; background-color:#ffffff; border-radius:8px; border:1px solid #e5e7eb; padding:24px; box-shadow:0 2px 6px rgba(0,0,0,0.05);'><h2 style='color:#111827; font-size:20px; margin-bottom:12px;'>✅ Appointment Confirmed</h2><p style='color:#374151; font-size:14px; line-height:22px; margin-bottom:16px;'>Hello <strong>{{PatientName}}</strong>,</p><p style='color:#374151; font-size:14px; line-height:22px; margin-bottom:16px;'>Your appointment has been successfully booked. Here are the details:</p><div style='background-color:#f3f4f6; border:1px solid #d1d5db; border-radius:6px; padding:16px; margin:16px 0;'><table style='width:100%; border-collapse:collapse;'><tr><td style='padding:6px 0; color:#6b7280; font-size:13px; width:110px;'>Date &amp; Time</td><td style='padding:6px 0; color:#111827; font-size:14px; font-weight:600;'>{{AppointmentDate}} at {{AppointmentTime}}</td></tr><tr><td style='padding:6px 0; color:#6b7280; font-size:13px;'>Doctor</td><td style='padding:6px 0; color:#111827; font-size:14px; font-weight:600;'>{{DoctorName}}</td></tr><tr><td style='padding:6px 0; color:#6b7280; font-size:13px;'>Service</td><td style='padding:6px 0; color:#111827; font-size:14px; font-weight:600;'>{{ServiceName}}</td></tr><tr><td style='padding:6px 0; color:#6b7280; font-size:13px;'>Specialty</td><td style='padding:6px 0; color:#111827; font-size:14px; font-weight:600;'>{{SpecialtyName}}</td></tr><tr><td style='padding:6px 0; color:#6b7280; font-size:13px;'>Clinic</td><td style='padding:6px 0; color:#111827; font-size:14px; font-weight:600;'>{{InstitutionName}}</td></tr><tr><td style='padding:6px 0; color:#6b7280; font-size:13px;'>Address</td><td style='padding:6px 0; color:#111827; font-size:14px; font-weight:600;'>{{InstitutionAddress}}</td></tr><tr><td style='padding:6px 0; color:#6b7280; font-size:13px;'>Price</td><td style='padding:6px 0; color:#111827; font-size:14px; font-weight:600;'>{{TotalPrice}}</td></tr></table></div><p style='color:#374151; font-size:14px; line-height:22px; margin-bottom:16px;'>Please arrive 10 minutes before your scheduled time. If you need to cancel or reschedule, please do so at least 24 hours in advance.</p><p style='color:#6b7280; font-size:12px; line-height:18px; margin-bottom:0;'>If you have any questions, contact us at <a href='mailto:contact@medsync.com' style='color:#2563eb; text-decoration:none;'>contact@medsync.com</a>.</p><hr style='border:none; border-top:1px solid #e5e7eb; margin:24px 0;' /><div style='text-align:center; color:#9ca3af; font-size:12px;'><strong>MedSync</strong><br/>Automated notification – please do not reply.</div></div></body></html>"
